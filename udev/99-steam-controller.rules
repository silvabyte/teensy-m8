# Valve Steam Controller udev rules (wired + wireless dongle).
# Required so sc-controller can read the device without root.

# uinput is required for the virtual gamepad sc-controller emits.
KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"

# All Valve USB devices
SUBSYSTEM=="usb", ATTRS{idVendor}=="28de", MODE="0666"

# Steam Controller - wired
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1102", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1102", MODE="0666"

# Steam Controller - wireless dongle
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1142", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1142", MODE="0666"
